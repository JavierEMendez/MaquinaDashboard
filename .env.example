# ── Maquina Dashboard environment ──────────────────────────────────
# Copy to `.env` for local dev. On Railway, set these as service vars.

# Primary Postgres for THIS app (users, companies, KPI data).
# Railway: reference the attached Postgres plugin, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@localhost:5432/maquina

# Flask session signing key. Generate a long random string in production.
SECRET_KEY=change-me-in-production

# First-run admin bootstrap (created only if the users table is empty).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=maquina2026

# Read-only connection to the EXISTING Ember dashboard's Postgres, used to
# pull live Ember figures. Leave blank to keep Ember on seeded fake data.
EMBER_DATABASE_URL=

# MXN per 1 USD. Used as a fallback when the live Banxico fetch is off.
# Set BANXICO_TOKEN to enable live rates (https://www.banxico.org.mx/SieAPIRest).
USD_MXN_RATE=17.3328
BANXICO_TOKEN=
